{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vitest/globals"]
  },
  "include": [
    ".wxt/wxt.d.ts",
    "entrypoints",
    "src",
    "tests",
    "scripts",
    "wxt.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
